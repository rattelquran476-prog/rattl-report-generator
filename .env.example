# =========================================================
# Rattel Operational Platform Environment Template
# Placeholder values only. Do not commit real secrets.
# =========================================================

# ---------------------------------------------------------
# Application URLs
# ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_PUBLIC_SITE_URL=https://ratel-quran.com
NEXT_PUBLIC_APP_DOMAIN=app.ratel-quran.com

# ---------------------------------------------------------
# Supabase - Public Client Variables
# Safe for browser when using anon key only
# ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------
# Supabase - Server Only
# Never expose these values to the browser
# ---------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=

# ---------------------------------------------------------
# Authentication / Sessions
# ---------------------------------------------------------
AUTH_COOKIE_NAME=
SESSION_SECRET=
JWT_SECRET=
PASSWORD_RESET_REDIRECT_URL=

# ---------------------------------------------------------
# Role and Access Control
# ---------------------------------------------------------
DEFAULT_USER_ROLE=parent
ADMIN_EMAIL_ALLOWLIST=
OPERATIONS_EMAIL_ALLOWLIST=
FINANCE_EMAIL_ALLOWLIST=

# ---------------------------------------------------------
# Fawaterk Payment Integration
# Server-side only. No card data is stored.
# ---------------------------------------------------------
FAWATERK_BASE_URL=
FAWATERK_API_KEY=
FAWATERK_WEBHOOK_SECRET=
FAWATERK_SUCCESS_URL=
FAWATERK_FAILURE_URL=
FAWATERK_PENDING_URL=

# ---------------------------------------------------------
# Email Provider
# ---------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ---------------------------------------------------------
# WhatsApp / Contact Links
# No real API secret unless explicitly approved later.
# ---------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_CONTACT_URL=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# ---------------------------------------------------------
# Monitoring and Logging
# ---------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# ---------------------------------------------------------
# Security / Rate Limiting
# ---------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
PUBLIC_FORM_RATE_LIMIT_MAX_REQUESTS=
PUBLIC_FORM_RATE_LIMIT_WINDOW_SECONDS=

# ---------------------------------------------------------
# Environment Mode
# Allowed values: local, staging, production
# ---------------------------------------------------------
APP_ENV=local
NODE_ENV=development

# ---------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------
ENABLE_PUBLIC_REGISTRATION=false
ENABLE_PAYMENT_TRACKING=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_WHATSAPP_NOTIFICATIONS=false
ENABLE_AUDIT_LOGGING=false

# ---------------------------------------------------------
# Safety Flags
# ---------------------------------------------------------
ALLOW_REAL_CHILD_DATA=false
ALLOW_PRODUCTION_DEPLOYMENT=false
ALLOW_CARD_DATA_STORAGE=false
